NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/api/google-ads/callback

# Local development only. Leave these unset in any deployed environment: they
# prefill the login form and enable the dev_admin_override shortcut, both of
# which are ignored when NODE_ENV is production.
DEV_ADMIN_EMAIL=you@example.com
DEV_ADMIN_PASSWORD=your_local_dev_password
NEXT_PUBLIC_DEV_ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=your_local_dev_password
