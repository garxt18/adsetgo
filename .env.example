NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_REDIRECT_URI=http://localhost:3001/api/google-ads/callback

# The public address of the app, e.g. https://adsetgo.com. Invitation and
# password-reset links are built from it; without it they use the address the
# request came in on, which in production should never be left to chance.
NEXT_PUBLIC_SITE_URL=

# Optional. Signs the Google Ads connect step so a connection cannot be pointed
# at another agency. When unset the Supabase service role key is used instead;
# set this to rotate one without the other.
GOOGLE_ADS_STATE_SECRET=

# Local development only. Leave these unset in any deployed environment: they
# prefill the login form and enable the dev_admin_override shortcut, both of
# which are ignored when NODE_ENV is production.
DEV_ADMIN_EMAIL=you@example.com
DEV_ADMIN_PASSWORD=your_local_dev_password
NEXT_PUBLIC_DEV_ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=your_local_dev_password

# Local development only, and refused by a deployment build. Set to 1 to serve
# generated report figures instead of querying Google Ads, for building and
# demonstrating the dashboards before a live account exists. Every response is
# flagged and the dashboards show a "Sample data" banner.
SAMPLE_DATA=0
